    "schemas": {
      "BillableItem": {
        "type": "object",
        "properties": {
          "billableItemGuid": {
            "type": "string",
            "description": "Unique identifier and is automatically generated by Aimsio system.\r\n This is only used to update existing object"
          },
          "billableItemCode": {
            "type": "string",
            "description": "Unique identifier, visible to end users.\r\nRequired for creating or updating an object"
          },
          "billableItemName": {
            "type": "string"
          },
          "billableItemTypeUname": {
            "type": "string",
            "enum": [
              "labour",
              "equipment",
              "material",
              "service",
              "unit_billing",
              "per_diem",
              "accommodation",
              "mileage",
              "surcharge"
            ],
            "description": "Required when creating a new object. Either `billableItemTypeUname` or `billableItemTypeName` is required"
          },
          "billableItemTypeName": {
            "type": "string",
            "description": "Required when creating a new object. Either `billableItemTypeUname` or `billableItemTypeName` is required"
          },
          "billableItemIsTrade": {
            "type": "boolean",
            "description": "Set this to true if `billableItemTypeName` = 'Labour'"
          },
          "billableItemIsEquipment": {
            "type": "boolean",
            "description": "Set this to true if `billableItemTypeName` = 'Equipment'"
          },
          "billableItemCategory": {
            "type": "string"
          },
          "billableItemDescription": {
            "type": "string"
          },
          "billableItemStatus": {
            "type": "string"
          },
          "billableItemDefaultRate": {
            "type": "number"
          },
          "billableItemDefaultRateType": {
            "type": "string",
            "description": "Either `billableItemDefaultRateType` or `billableItemDefaultRateTypeUname` is required'"
          },
          "billableItemDefaultRateTypeUname": {
            "type": "string",
            "description": "Either `billableItemDefaultRateType` or `billableItemDefaultRateTypeUname` is required'"
          },
          "billableItemDefaultRate2": {
            "type": "number"
          },
          "billableItemDefaultRateType2": {
            "type": "string",
            "description": "If `billableItemDefaultRate2` is provided, either `billableItemDefaultRateType2` or `billableItemDefaultRateTypeUname2` is required"
          },
          "billableItemDefaultRateTypeUname2": {
            "type": "string",
            "description": "If `billableItemDefaultRate2` is provided, either `billableItemDefaultRateType2` or `billableItemDefaultRateTypeUname2` is required"
          },
          "billableItemDefaultRate3": {
            "type": "number"
          },
          "billableItemDefaultRateType3": {
            "type": "string",
            "description": "If `billableItemDefaultRate3` is provided, either `billableItemDefaultRateType3` or `billableItemDefaultRateTypeUname3` is required"
          },
          "billableItemDefaultRateTypeUname3": {
            "type": "string",
            "description": "If `billableItemDefaultRate3` is provided, either `billableItemDefaultRateType3` or `billableItemDefaultRateTypeUname3` is required"
          },
          "billableItemDefaultCost": {
            "type": "number",
            "description": "Cost Rates are only available for certain customer tiers"
          },
          "billableItemDefaultCost2": {
            "type": "number",
            "description": "Cost Rates are only available for certain customer tiers"
          },
          "billableItemDefaultCost3": {
            "type": "number",
            "description": "Cost Rates are only available for certain customer tiers"
          },
          "billableItemGlAccountNumber": {
            "type": "string",
            "description": "Applicable to accounts with GL Account master data enabled. \r\nMust be an existing GL Account number"
          },
          "billableItemGlAccountInfo": {
            "type": "string",
            "readOnly": true
          },
          "billableItemCreatedAt": {
            "type": "integer",
            "description": "Timestamp in epoch millseconds",
            "readOnly": true
          },
          "billableItemCreatedByUserName": {
            "type": "string",
            "readOnly": true
          },
          "billableItemCreatedByFullName": {
            "type": "string",
            "readOnly": true
          },
          "billableItemUpdatedAt": {
            "type": "integer",
